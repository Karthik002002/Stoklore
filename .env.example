# =========================================================================
# Stoklore Environment Configuration
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env
# =========================================================================

# --- Application & Port Settings ---
PORT=8010

# --- Database Settings (PostgreSQL + pgvector) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=crawler
POSTGRES_PORT=5432

# In Docker, DATABASE_URL is constructed automatically from the variables above.
# For bare-metal / local virtualenv runs, specify the full URL if needed:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crawler

# --- Ollama Configuration ---
# Point to your Ollama server:
# - For Ollama running on Mac/host: http://host.docker.internal:11434
# - For Ollama running in Docker (--profile ollama): http://ollama:11434
# - For Ollama on a remote network: http://192.168.1.100:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- LiteLLM Proxy (Optional: --profile litellm) ---
# Only needed if routing requests to commercial cloud LLMs (OpenAI, Claude, etc.)
LITELLM_BASE_URL=http://litellm:4000
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# NVIDIA_NIM_API_KEY=
# LITELLM_MASTER_KEY=

# --- Langfuse Tracing (Optional: --profile tracing) ---
# From a project created at http://localhost:3000
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=http://langfuse-web:3000

# Copy to .env (gitignored) and fill in what you actually use:
#   cp .env.example .env
# docker compose reads it for the variables below; the LiteLLM proxy auto-loads it from the
# working directory too - no need to `export` anything by hand.

# --- Docker (docker-compose.yml) ---
# Required: the database password, read when the database volume is first created.
POSTGRES_PASSWORD=
# POSTGRES_USER=stoklore
# POSTGRES_DB=stoklore
# Host port for the app, bound to 127.0.0.1.
# PORT=8010
# Where the container finds Ollama. Default: the host's (http://host.docker.internal:11434);
# with `--profile ollama`, use the container's:
# OLLAMA_BASE_URL=http://ollama:11434
# With `--profile litellm`:
# LITELLM_BASE_URL=http://litellm:4000

# --- Native install ---
# Postgres connection string for db.py - only needed if it differs from the default
# ("postgresql:///crawler", i.e. local Unix socket, current OS user, db named "crawler").
# DATABASE_URL=postgresql:///crawler

# --- LiteLLM proxy (config/litellm.config.yaml) - only needed if you're using litellm/* models ---
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# NVIDIA_NIM_API_KEY=
# Requires every request (including this app's) to send `Authorization: Bearer <this value>`.
# Leave unset to run the proxy with no auth, for local-only use.
# LITELLM_MASTER_KEY=

# --- Langfuse tracing (optional) ---
# From a project created at http://localhost:3000 (self-hosted).
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=http://localhost:3000
# Secrets for the self-hosted Langfuse stack under `--profile tracing` - set them before its first
# start (ENCRYPTION_KEY: 64 hex chars, `openssl rand -hex 32`).
# LANGFUSE_ENCRYPTION_KEY=
# LANGFUSE_SALT=
# LANGFUSE_NEXTAUTH_SECRET=
# LANGFUSE_DB_PASSWORD=
# LANGFUSE_CLICKHOUSE_PASSWORD=
# LANGFUSE_MINIO_PASSWORD=
# LANGFUSE_REDIS_PASSWORD=

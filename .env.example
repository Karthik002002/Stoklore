# Copy to .env (gitignored) and fill in what you actually use. litellm auto-loads this file
# from the working directory on startup - no need to `export` anything by hand.

# Postgres connection string for db.py - only needed if it differs from the default
# ("postgresql:///crawler", i.e. local Unix socket, current OS user, db named "crawler").
# DATABASE_URL=postgresql:///crawler

# --- LiteLLM proxy (litellm.config.yaml) - only needed if you're using litellm/* models ---
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Requires every request (including this app's) to send `Authorization: Bearer <this value>`.
# Leave unset to run the proxy with no auth, for local-only use.
# LITELLM_MASTER_KEY=

# --- Langfuse tracing (optional, see docker-compose.langfuse.yml) ---
# From a project created at http://localhost:3000 (self-hosted) after `./run.sh` starts it.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=http://localhost:3000

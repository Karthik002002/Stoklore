<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: the launcher icon on the app's own background, so the hand-off
         to the in-app intro (assets/index.html #intro) is seamless -->
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/panel</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowSplashScreenBackground">@color/bg</item>
        <item name="android:windowSplashScreenAnimationDuration">300</item>
    </style>
</resources>
